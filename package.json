{
    "version":  "1.0.0",
    "name":  "shopify-meta-public-knowledge-publisher",
    "scripts":  {
                    "update":  "npm run refresh \u0026\u0026 npm run publish",
                    "community-discover":  "node --disable-warning=ExperimentalWarning scripts/public-open-source-discovery.mjs",
                    "publish":  "node --disable-warning=ExperimentalWarning scripts/build-public-knowledge-package.mjs",
                    "verify:published":  "node scripts/verify-published-package.mjs",
                    "refresh":  "node scripts/public-knowledge-refresh.mjs",
                    "test":  "node --disable-warning=ExperimentalWarning --test",
                    "automation:shadow":  "node 自动化/official-knowledge-coordinator.mjs",
                    "automation:shadow-status":  "node 自动化/shadow-observation-status.mjs",
                    "automation:public":  "set OFFICIAL_KNOWLEDGE_AUTOMATION_MODE=public&& set OFFICIAL_KNOWLEDGE_PUBLIC_REFRESH_APPROVED=1&& node 自动化/official-knowledge-coordinator.mjs"
                },
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=22"
                },
    "private":  true
}
